# LUM 두 엔진을 OpenAI 호환 endpoint로 사용 — base_url + api_key만 바꿔 쓰면 됨.
#
# 셋업:
#   cp .env.example .env
#   # 그 다음 .env 파일을 열어 ${...} 자리에 실제 값 채우기.
#   # .env는 .gitignore 처리됨 — 절대 commit 하지 말 것.

# === Fast Track (TabbyAPI :5000) — 7~14B EXL2 ===
# TABBY_API_KEY: ~/.lum_config.json 의 xllm_api_key 값 또는 TabbyAPI config의 api_keys 중 하나
TABBY_BASE_URL=http://127.0.0.1:5000/v1
TABBY_API_KEY=${YOUR_TABBY_API_KEY}
TABBY_MODEL=Qwen2.5-Coder-7B-Instruct-4bpw

# === Heavy Track (mistral.rs :8080) — BF16 ISQ 또는 GGUF MoE ===
# mistral.rs는 internally `default` 또는 로딩 시 지정한 절대 경로를 model id로 받음.
# `default`가 가장 안전 — 어떤 모델이 로드되어 있든 자동 매칭.
MISTRAL_BASE_URL=http://127.0.0.1:8080/v1
MISTRAL_API_KEY=any
MISTRAL_MODEL=default
